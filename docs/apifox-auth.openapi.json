{
  "openapi": "3.0.3",
  "info": {
    "title": "r-admin Auth & System User Debug API",
    "version": "0.2.0",
    "description": "OpenAPI import file for APIFox. Covers the current backend debugging endpoints for health, auth, and the first user-management slice."
  },
  "servers": [
    {
      "url": "http://127.0.0.1:8080",
      "description": "Local backend service"
    }
  ],
  "tags": [
    {
      "name": "Health",
      "description": "Service health checks"
    },
    {
      "name": "Auth",
      "description": "Authentication endpoints for the initial auth slice"
    },
    {
      "name": "System User",
      "description": "First user-management endpoints for list, detail, create, update, and status change"
    }
  ],
  "paths": {
    "/api/health": {
      "get": {
        "tags": [
          "Health"
        ],
        "summary": "Health check",
        "description": "Checks whether the backend service is running and whether PostgreSQL is reachable.",
        "operationId": "getHealth",
        "responses": {
          "200": {
            "description": "Health check result",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                },
                "example": {
                  "code": 0,
                  "message": "ok",
                  "data": {
                    "status": "ok",
                    "service": "r-admin-backend",
                    "database": "up"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/auth/login": {
      "post": {
        "tags": [
          "Auth"
        ],
        "summary": "Login",
        "description": "Logs in with username and password. Default seeded admin account: `admin` / `Admin@123456`.",
        "operationId": "postAuthLogin",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              },
              "example": {
                "username": "admin",
                "password": "Admin@123456"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Login success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LoginResponseEnvelope"
                },
                "example": {
                  "code": 0,
                  "message": "ok",
                  "data": {
                    "access_token": "jwt-token",
                    "token_type": "Bearer",
                    "expires_in": 7200,
                    "user": {
                      "id": 1000,
                      "username": "admin",
                      "nickname": "超级管理员",
                      "real_name": "平台管理员",
                      "is_super_admin": true
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Request validation error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "code": 400,
                  "message": "username is required",
                  "data": null
                }
              }
            }
          },
          "401": {
            "description": "Invalid credentials",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "code": 401,
                  "message": "username or password is incorrect",
                  "data": null
                }
              }
            }
          },
          "403": {
            "description": "Disabled account",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "code": 403,
                  "message": "user account is disabled",
                  "data": null
                }
              }
            }
          }
        }
      }
    },
    "/api/auth/me": {
      "get": {
        "tags": [
          "Auth"
        ],
        "summary": "Get current user",
        "description": "Returns current user profile, role codes, and permission codes based on the bearer token.",
        "operationId": "getAuthMe",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Current user information",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CurrentUserResponseEnvelope"
                },
                "example": {
                  "code": 0,
                  "message": "ok",
                  "data": {
                    "user": {
                      "id": 1000,
                      "username": "admin",
                      "nickname": "超级管理员",
                      "real_name": "平台管理员",
                      "is_super_admin": true
                    },
                    "roles": [
                      "super_admin"
                    ],
                    "permissions": [
                      "dashboard:view",
                      "system:user:list",
                      "system:user:create"
                    ]
                  }
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "code": 401,
                  "message": "invalid or expired access token",
                  "data": null
                }
              }
            }
          },
          "403": {
            "description": "Disabled account",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "code": 403,
                  "message": "user account is disabled",
                  "data": null
                }
              }
            }
          },
          "404": {
            "description": "Current user not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "code": 404,
                  "message": "current user not found",
                  "data": null
                }
              }
            }
          }
        }
      }
    },
