{
  "openapi": "3.0.3",
  "info": {
    "title": "r-admin Auth Debug API",
    "version": "0.1.0",
    "description": "OpenAPI import file for APIFox. Covers the current backend auth debugging endpoints: health, login, current user, current menus, and logout."
  },
  "servers": [
    {
      "url": "http://127.0.0.1:8080",
      "description": "Local backend service"
    }
  ],
  "tags": [
    {
      "name": "Health",
      "description": "Service health checks"
    },
    {
      "name": "Auth",
      "description": "Authentication endpoints for the first auth initialization slice"
    }
  ],
  "paths": {
    "/api/health": {
      "get": {
        "tags": [
          "Health"
        ],
        "summary": "Health check",
        "description": "Checks whether the backend service is running and whether PostgreSQL is reachable.",
        "operationId": "getHealth",
        "responses": {
          "200": {
            "description": "Health check result",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                },
                "example": {
                  "code": 0,
                  "message": "ok",
                  "data": {
                    "status": "ok",
                    "service": "r-admin-backend",
                    "database": "up"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/auth/login": {
      "post": {
        "tags": [
          "Auth"
        ],
        "summary": "Login",
        "description": "Logs in with username and password. Default seeded admin account: `admin` / `Admin@123456`.",
        "operationId": "postAuthLogin",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              },
              "example": {
                "username": "admin",
                "password": "Admin@123456"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Login success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LoginResponseEnvelope"
                },
                "example": {
                  "code": 0,
                  "message": "ok",
                  "data": {
                    "access_token": "jwt-token",
                    "token_type": "Bearer",
                    "expires_in": 7200,
                    "user": {
                      "id": 1000,
                      "username": "admin",
                      "nickname": "超级管理员",
                      "real_name": "平台管理员",
                      "is_super_admin": true
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Request validation error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "code": 400,
                  "message": "username is required",
                  "data": null
                }
              }
            }
          },
          "401": {
            "description": "Invalid credentials",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "code": 401,
                  "message": "username or password is incorrect",
                  "data": null
                }
              }
            }
          },
          "403": {
            "description": "Disabled account",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "code": 403,
                  "message": "user account is disabled",
                  "data": null
                }
              }
            }
          }
        }
      }
    },
    "/api/auth/me": {
      "get": {
        "tags": [
          "Auth"
        ],
        "summary": "Get current user",
        "description": "Returns current user profile, role codes, and permission codes based on the bearer token.",
        "operationId": "getAuthMe",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Current user information",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CurrentUserResponseEnvelope"
                },
                "example": {
                  "code": 0,
                  "message": "ok",
                  "data": {
                    "user": {
                      "id": 1000,
                      "username": "admin",
                      "nickname": "超级管理员",
                      "real_name": "平台管理员",
                      "is_super_admin": true
                    },
                    "roles": [
                      "super_admin"
                    ],
                    "permissions": [
                      "dashboard:view",
                      "system:user:list",
                      "system:user:create"
                    ]
                  }
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "code": 401,
                  "message": "invalid or expired access token",
                  "data": null
                }
              }
            }
          },
          "403": {
            "description": "Disabled account",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "code": 403,
                  "message": "user account is disabled",
                  "data": null
                }
              }
            }
          },
          "404": {
            "description": "Current user not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "code": 404,
                  "message": "current user not found",
                  "data": null
                }
              }
            }
          }
        }
      }
    },
    "/api/auth/menus": {
      "get": {
        "tags": [
          "Auth"
        ],
        "summary": "Get current menus",
        "description": "Returns the current user's visible menu tree based on the bearer token and role permissions.",
        "operationId": "getAuthMenus",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Current user menus",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CurrentMenusResponseEnvelope"
                },
                "example": {
                  "code": 0,
                  "message": "ok",
                  "data": {
                    "menus": [
                      {
                        "id": "20000",
                        "name": "DashboardRoot",
                        "title": "首页",
                        "path": null,
                        "icon": "histogram",
                        "permission": null,
                        "hidden": false,
                        "children": [
                          {
                            "id": "20001",
                            "name": "DashboardWorkbench",
                            "title": "工作台",
                            "path": "/dashboard",
                            "icon": "histogram",
                            "permission": "dashboard:view",
                            "hidden": false,
                            "children": []
                          }
                        ]
                      }
                    ]
                  }
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "code": 401,
                  "message": "invalid or expired access token",
                  "data": null
                }
              }
            }
          },
          "403": {
            "description": "Disabled account",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "code": 403,
                  "message": "user account is disabled",
                  "data": null
                }
              }
            }
          },
          "404": {
            "description": "Current user not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "code": 404,
                  "message": "current user not found",
                  "data": null
                }
              }
            }
          }
        }
      }
    },
    "/api/auth/logout": {
      "post": {
        "tags": [
          "Auth"
        ],
        "summary": "Logout",
        "description": "Current implementation is a lightweight placeholder endpoint. It validates the bearer token and returns a local logout success response.",
        "operationId": "postAuthLogout",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Logout success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LogoutResponseEnvelope"
                },
                "example": {
                  "code": 0,
                  "message": "ok",
                  "data": {
                    "logged_out": true
                  }
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "code": 401,
                  "message": "missing authorization header",
                  "data": null
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "HealthPayload": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "example": "ok"
          },
          "service": {
            "type": "string",
            "example": "r-admin-backend"
          },
          "database": {
            "type": "string",
            "example": "up"
          }
        },
        "required": [
          "status",
          "service",
          "database"
        ]
      },
      "HealthResponse": {
        "type": "object",
        "properties": {
          "code": {
            "type": "integer",
            "example": 0
          },
          "message": {
            "type": "string",
            "example": "ok"
          },
          "data": {
            "$ref": "#/components/schemas/HealthPayload"
          }
        },
        "required": [
          "code",
          "message",
          "data"
        ]
      },
      "LoginRequest": {
        "type": "object",
        "properties": {
          "username": {
            "type": "string",
            "example": "admin"
          },
          "password": {
            "type": "string",
            "example": "Admin@123456"
          }
        },
        "required": [
          "username",
          "password"
        ]
      },
      "AuthUserProfile": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64",
            "example": 1000
          },
          "username": {
            "type": "string",
            "example": "admin"
          },
          "nickname": {
            "type": "string",
            "example": "超级管理员"
          },
          "real_name": {
            "type": "string",
            "nullable": true,
            "example": "平台管理员"
          },
          "is_super_admin": {
            "type": "boolean",
            "example": true
          }
        },
        "required": [
          "id",
          "username",
          "nickname",
          "is_super_admin"
        ]
      },
      "LoginResponse": {
        "type": "object",
        "properties": {
          "access_token": {
            "type": "string",
            "example": "jwt-token"
          },
          "token_type": {
            "type": "string",
            "example": "Bearer"
          },
          "expires_in": {
            "type": "integer",
            "format": "int64",
            "example": 7200
          },
          "user": {
            "$ref": "#/components/schemas/AuthUserProfile"
          }
        },
        "required": [
          "access_token",
          "token_type",
          "expires_in",
          "user"
        ]
      },
      "LoginResponseEnvelope": {
        "type": "object",
        "properties": {
          "code": {
            "type": "integer",
            "example": 0
          },
          "message": {
            "type": "string",
            "example": "ok"
          },
          "data": {
            "$ref": "#/components/schemas/LoginResponse"
          }
        },
        "required": [
          "code",
          "message",
          "data"
        ]
      },
      "CurrentUserResponse": {
        "type": "object",
        "properties": {
          "user": {
            "$ref": "#/components/schemas/AuthUserProfile"
          },
          "roles": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "example": [
              "super_admin"
            ]
          },
          "permissions": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "example": [
              "dashboard:view",
              "system:user:list"
            ]
          }
        },
        "required": [
          "user",
          "roles",
          "permissions"
        ]
      },
      "CurrentUserResponseEnvelope": {
        "type": "object",
        "properties": {
          "code": {
            "type": "integer",
            "example": 0
          },
          "message": {
            "type": "string",
            "example": "ok"
          },
          "data": {
            "$ref": "#/components/schemas/CurrentUserResponse"
          }
        },
        "required": [
          "code",
          "message",
          "data"
        ]
      },
      "CurrentMenuItem": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "example": "20001"
          },
          "name": {
            "type": "string",
            "example": "DashboardWorkbench"
          },
          "title": {
            "type": "string",
            "example": "工作台"
          },
          "path": {
            "type": "string",
            "nullable": true,
            "example": "/dashboard"
          },
          "icon": {
            "type": "string",
            "nullable": true,
            "example": "histogram"
          },
          "permission": {
            "type": "string",
            "nullable": true,
            "example": "dashboard:view"
          },
          "hidden": {
            "type": "boolean",
            "example": false
          },
          "children": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CurrentMenuItem"
            }
          }
        },
        "required": [
          "id",
          "name",
          "title",
          "hidden",
          "children"
        ]
      },
      "CurrentMenusResponse": {
        "type": "object",
        "properties": {
          "menus": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CurrentMenuItem"
            }
          }
        },
        "required": [
          "menus"
        ]
      },
      "CurrentMenusResponseEnvelope": {
        "type": "object",
        "properties": {
          "code": {
            "type": "integer",
            "example": 0
          },
          "message": {
            "type": "string",
            "example": "ok"
          },
          "data": {
            "$ref": "#/components/schemas/CurrentMenusResponse"
          }
        },
        "required": [
          "code",
          "message",
          "data"
        ]
      },
      "LogoutPayload": {
        "type": "object",
        "properties": {
          "logged_out": {
            "type": "boolean",
            "example": true
          }
        },
        "required": [
          "logged_out"
        ]
      },
      "LogoutResponseEnvelope": {
        "type": "object",
        "properties": {
          "code": {
            "type": "integer",
            "example": 0
          },
          "message": {
            "type": "string",
            "example": "ok"
          },
          "data": {
            "$ref": "#/components/schemas/LogoutPayload"
          }
        },
        "required": [
          "code",
          "message",
          "data"
        ]
      },
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "code": {
            "type": "integer",
            "example": 401
          },
          "message": {
            "type": "string",
            "example": "invalid or expired access token"
          },
          "data": {
            "nullable": true
          }
        },
        "required": [
          "code",
          "message",
          "data"
        ]
      }
    }
  }
}
