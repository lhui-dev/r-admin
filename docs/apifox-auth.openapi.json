                        ]
                      }
                    ]
                  }
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "code": 401,
                  "message": "invalid or expired access token",
                  "data": null
                }
              }
            }
          },
          "403": {
            "description": "Disabled account",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "code": 403,
                  "message": "user account is disabled",
                  "data": null
                }
              }
            }
          },
          "404": {
            "description": "Current user not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "code": 404,
                  "message": "current user not found",
                  "data": null
                }
              }
            }
          }
        }
      }
    },
    "/api/auth/logout": {
      "post": {
        "tags": [
          "Auth"
        ],
        "summary": "Logout",
        "description": "Current implementation is a lightweight placeholder endpoint. It validates the bearer token and returns a local logout success response.",
        "operationId": "postAuthLogout",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Logout success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LogoutResponseEnvelope"
                },
                "example": {
                  "code": 0,
                  "message": "ok",
                  "data": {
                    "logged_out": true
                  }
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "code": 401,
                  "message": "missing authorization header",
                  "data": null
                }
              }
            }
          }
        }
      }
    },
    "/api/system/users": {
      "get": {
        "tags": [
          "System User"
        ],
        "summary": "List users",
        "description": "Returns the first-version paginated user list. Supports keyword, department, and status filtering.",
        "operationId": "getSystemUsers",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "description": "Page number. Defaults to 1.",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int64",
              "minimum": 1,
              "example": 1
            }
          },
          {
            "name": "page_size",
            "in": "query",
            "description": "Page size. Defaults to 20 and is clamped to 1-100.",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int64",
              "minimum": 1,
              "maximum": 100,
              "example": 20
            }
          },
          {
            "name": "keyword",
            "in": "query",
            "description": "Fuzzy matches username, nickname, real_name, and mobile.",
            "required": false,
            "schema": {
              "type": "string",
              "example": "operator131857"
            }
          },
          {
            "name": "dept_id",
            "in": "query",
            "description": "Department filter.",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int64",
              "example": 120
            }
          },
          {
            "name": "status",
            "in": "query",
            "description": "User status filter. `1` enabled, `0` disabled.",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int32",
              "enum": [
                0,
                1
              ],
              "example": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Paginated user list",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserListResponseEnvelope"
                },
                "example": {
                  "code": 0,
                  "message": "ok",
                  "data": {
                    "items": [
                      {
                        "id": 1030,
                        "username": "operator131857",
                        "nickname": "操作员测试-更新",
                        "real_name": "联调测试用户",
                        "mobile": "13900001318",
                        "email": "operator131857@example.com",
                        "status": 0,
                        "is_super_admin": false,
                        "dept": {
                          "id": 120,
                          "name": "运营中心"
                        },
                        "roles": [],
                        "posts": [],
                        "last_login_at": null,
                        "created_at": "2026-06-03T05:18:57Z"
                      }
                    ],
                    "pagination": {
                      "page": 1,
                      "page_size": 20,
                      "total": 1
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "code": 401,
                  "message": "missing authorization header",
                  "data": null
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "System User"
        ],
        "summary": "Create user",
        "description": "Creates a first-version system user. Roles and posts are not assigned by this endpoint yet.",
        "operationId": "postSystemUsers",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateUserRequest"
              },
              "example": {
                "username": "operator131857",
                "password": "Admin@123456",
                "nickname": "操作员测试",
                "real_name": "联调测试用户",
                "mobile": "13900001318",
                "email": "operator131857@example.com",
                "gender": 1,
                "dept_id": 110,
                "status": 1,
                "remark": "APIFox 联调用临时用户"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "User created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserMutationResponseEnvelope"
                },
                "example": {
                  "code": 0,
                  "message": "ok",
                  "data": {
                    "id": 1030,
                    "username": "operator131857"
                  }
                }
              }
            }
          },
          "400": {
            "description": "Validation error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "code": 400,
                  "message": "dept_id does not exist",
                  "data": null
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "code": 401,
                  "message": "invalid or expired access token",
                  "data": null
                }
              }
            }
          },
          "409": {
            "description": "Unique constraint conflict",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "code": 409,
                  "message": "username already exists",
                  "data": null
                }
              }
            }
          }
        }
      }
    },
